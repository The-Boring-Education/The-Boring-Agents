# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Other LLM Providers (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Application Configuration
LOG_LEVEL=INFO
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Content Generation Settings
DEFAULT_MODEL=gpt-3.5-turbo
MAX_TOKENS=2000
TEMPERATURE=0.7

# API Target Configuration
# ENVIRONMENT controls which base URL is used for uploads: local, dev, or prod
# For ENVIRONMENT=dev|prod, ADMIN_SECRET must be a strong non-default value
# (not empty and not the historical default "TBEAdmin").
ENVIRONMENT=local
LOCAL_API_BASE_URL=http://localhost:3000
DEV_API_BASE_URL=https://tbe-dev-git-development-tbe.vercel.app
PROD_API_BASE_URL=https://www.theboringeducation.com
ADMIN_SECRET=change-me-to-a-strong-secret

# Optional dedicated inbound API key (falls back to ADMIN_SECRET if unset)
# AGENTS_API_KEY=
